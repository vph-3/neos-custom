/* Example images: https://github.com/ZerafinaCSS/zerafinacss.github.io/tree/main/ao3/header-image */

#header::after {
  display: block;
  order: 3;
  width: 100%;
  height: 16.75vw;
  border-top: var(--border-width) solid var(--border2); /* same as header bottom border */
  background:
    url("https://raw.githubusercontent.com/ZerafinaCSS/zerafinacss.github.io/refs/heads/main/ao3/header-image/celestial-tumblr-blue.png") /* paste image url between quotation marks; recommended size: 2240x375px (or same aspect ratio) */
    var(--bg8) /* fallback background color */
    no-repeat;
  background-size: cover;
  content: "";
}

