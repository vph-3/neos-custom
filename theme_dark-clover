/*============================================================
GLOBAL VARIABLES
==============================================================

Color palettes used:

Clover:   https://coolors.co/416c44-37863e-7ac37c-afd382-93bf5a-90b983-e7ffc9
Dusty Yellow: https://coolors.co/121212-1c1c1c-2b2b2b-333333-424242-545454-706e66-8a8576-d4d0c5

*/

:root {

  color-scheme:          dark;                     /* which system color scheme an (unstyleable) element should render with */


/*>========== UI PARAMETERS ==========<*/

  /* space on left/right side of screen */
  --margins-header:      1rem;                     /* header on desktop */
  --margins-main:        5%;                       /* site contents on desktop */
  --margins-narrow:      2.5%;                     /* site contents and header on tablet/mobile */

  /* border-radius (= roundness of corners) */
  --radius-small:        4px;                      /* smaller elements: list elements, input elements etc. */
  --radius-mid:          6px;                      /* midsizde elements: dropdown menus, system messages etc. */
  --radius-big:          8px;                      /* bigger elements: blurbs, forms, comments, textareas etc. */
  --radius-btn:          14px;                     /* header search box, buttons */
  --radius-tag:          8px;                      /* tags */

  /* icon border-radius */
  --icon-content-radius: 6px;                      /* content and bookmark icon */
  --icon-primary-radius: 8px;                      /* primary and comment icon */
  --icon-index-radius:   8px;                      /* index icon */


/*>========== MAIN BACKGROUND COLORS ==========<*/

  --bg1:                 #1D1D1D;                  /* main background, footer etc. */
  --bg2:                 #2B2B2B;                  /* header */
  --bg3:                 transparent;              /* dashboard */
  --bg4:                 #2B2B2B;                  /* forms, modal dialogs, javascript context etc. */
  --bg5:                 #2B2B2B;                  /* content boxes (blurbs, comments etc.), meta box */
  --bg6:                 #2B2B2B;                  /* dropdown and secondary menus, tooltips etc. */
  --bg7:                 #323232;                  /* own blurbs, listbox, some even/odd list items etc. */
  --bg8:                 #93BF5A;                  /* collection header */


/*>========== MAIN BORDERS ==========<*/

  /* colors */
  --border1:             #434343;                  /* dashboard, footer, news, blockquote, scrollbar track etc. */
  --border2:             #434343;                  /* header, tables, forms, input elements, listbox etc. */
  --border3:             #434343;                  /* content boxes (blurbs, comments etc.), dropdown and secondary menus */
  --border4:             #706E66;                  /* meta boxes, tooltips, some heading underlines, scrollbar thumb etc. */

  /* width */
  --border-width:        1px;                      /* for almost all borders (experimental - changing this might cause some weirdness) */


/*>========== SHADOWS ==========<*/
/* replace values with "none" (without quotation marks) to remove shadows */

  --shadow:              0 5px 10px #111111B3;     /* secondary elements, dropdowns, tooltips etc. */
  --shadow-header:       none;
  --shadow-buttons:      none;


/*>========== MAIN TEXT ==========<*/

  /* text size */
  --txt-size-main:       100%;                     /* main text size (bigger than 130% causes some issues, but is still mostly functional) */
  --txt-size-work:       110%;                     /* work text size */

  /* text colors */
  --txt-header:          #93BF5A;                  /* header text */
  --txt-header-hgl:      #fff4c4;                  /* selected header dropdown toggle and link items */
  --txt-header-hgl-h1:   linear-gradient(135deg, #f8ffd8, #cee182, #6a9235); /* gradient for selected AO3 header title */
  --txt-main:            #D4D0C5;                  /* main body text */
  --txt-alt1:            #D4D0C5;                  /* announcements */
  --txt-alt2:            #111111;                  /* checkbox checkmark, help symbol, event announcements etc. */

  /* links */
  --link:                #93BF5A;                  /* link color */
  --link-hgl:            #E7FFC9;                  /* color for hovered/focused links */
  --link-visited:        #8A8576;                  /* color for already visited links + header search bar icon */
  --link-underline:      1px solid transparent;    /* link underline => delete "transparent" to make link underlines visible */


/*>========== INTERACTION COLORS ==========<*/
/* = buttons, input and select elements */

  /* button colors */
  --int-btn-bg:          #2B2B2B;                  /* background */
  --int-btn-border:      #416C448C;                /* border */
  --int-btn-txt:         #93BF5A;                  /* text */
  --int-btn-hgl-bg:      linear-gradient(135deg, #E1FC99, #D6F67E, #CAF062); /* background for hovered/focused buttons */
  --int-btn-hgl-txt:     #111111;                  /* text for hovered/focused buttons */                                                                        
  
  --int-bg:              #1D1D1D;                  /* background for input and select elements */

  --int-current-bg:      #323232;                  /* background for currently active elements */
  --int-current-txt:     #EFEAEB;                  /* text for currently active elements */
  --int-disabled-bg:     #2B2B2B;                  /* background for disabled buttons and checkboxes */
  --int-checked:         #93BF5A;                  /* checked checkboxes and radio buttons */
  
  --int-hgl:             #E1FC99;                  /* highlight for hovered/focused/selected elements */
  --int-hgl-bg:          linear-gradient(135deg, #E1FC99, #D6F67E, #CAF062); /* background for hovered/focused list items */
  --int-hgl-txt:         #111111;                  /* text for hovered/focused list items and for collection header */


/*>========== ICON COLORS ==========<*/

  /* bookmark and content icons (mostly) */  
  --icon1:               #90B983;                  /* gen, complete, public bookmark */
  --icon2:               #93BF5A;                  /* teen */
  --icon3:               #93BF5A;                  /* m/m, external work */
  --icon4:               #7AC37C;                  /* mature, chose not to warn, rss feed */
  --icon5:               #7AC37C;                  /* f/m */
  --icon6:               #37863E;                  /* explicit, f/f, warning, incomplete */
  --icon7:               #416C44;                  /* private bookmark */
  --icon8:               #8A8576;                  /* hidden bookmark */
  --icon9:               #7AC37C;                  /* rec bookmark */

  /* gradient overlay for the bookmark and content icons above */
  --icon-grd:            linear-gradient(135deg, transparent, #1D1D1D75);

  /* other icons */
  --icon-bg:             linear-gradient(135deg, #323232, #545454); /* background for empty icon box or uploaded icon with transparent background */
  --icon-id:             linear-gradient(135deg, #90B983, #434343); /* user, skin, tag, admin */
  --icon-anon:           linear-gradient(135deg, #706E66, #323232); /* guest, anonymous user */
  --icon-coll:           linear-gradient(135deg, #93BF5A, #434343); /* collection, unrevealed work */

  /* icon borders */
  --icon-border1:        none;                     /* border for most icons */
  --icon-border2:        none;                     /* uploaded, default user and mystery icon + empty symbols box */


/*>========== TAG COLORS ==========<*/

  /* background */
  --tag-default-bg:      linear-gradient(135deg, #90B9830D, #00000026);
  --tag-fandom-bg:       linear-gradient(135deg, #90B9830D, #00000026);
  --tag-warning-bg:      #37863E linear-gradient(135deg, #D4D0C54D, #1D1D1D33);
  --tag-ship-bg:         #7AC37C linear-gradient(135deg, #D4D0C54D, #1D1D1D4D);
  --tag-platonic-bg:     #7AC37C linear-gradient(135deg, #D4D0C54D, #1D1D1D4D);
  --tag-character-bg:    linear-gradient(135deg, #90B9830D, #00000026);
  --tag-freeform-bg:     linear-gradient(135deg, #90B9830D, #00000026);

  /* text */
  --tag-default-txt:     #D4D0C5;
  --tag-fandom-txt:      #D4D0C5;
  --tag-warning-txt:     #111111;
  --tag-ship-txt:        #111111;
  --tag-platonic-txt:    #111111;
  --tag-character-txt:   #AFD382;
  --tag-freeform-txt:    #E7FFC9;

  /* border */
  --tag-border:          #416C4459;

  /* hover and focus */
  --tag-hgl-bg:          linear-gradient(135deg, #E1FC99, #D6F67E, #CAF062); /* background */
  --tag-hgl-txt:         #111111;                  /* text */


/*>========== COLORS FOR ROLES AND STATES + SYSTEM MESSAGES ==========<*/
/* palette: https://coolors.co/231b05-ba9d57-211312-cc716c-161914-81a577-1a1b05-b4b743 */

  /* background */
  --notice-bg:           #231B05;
  --success-bg:          #211312;
  --caution-bg:          #161914;
  --alert-bg:            #1A1B05;

  /* text (and borders) */
  --notice-txt:          #BA9D57;
  --success-txt:         #CC716C;
  --caution-txt:         #81A577;
  --alert-txt:           #B4B743;


/*>========== FILTERS ==========<*/
/* the colors of the following elements can only be changed using filters; adjust filter values to change colors */

  --header-icon:         brightness(0) saturate(100%) invert(74%) sepia(10%) saturate(1890%) hue-rotate(44deg) brightness(95%) contrast(84%);
  --header-icon-hgl:     brightness(0) saturate(100%) invert(95%) sepia(9%) saturate(1495%) hue-rotate(324deg) brightness(105%) contrast(105%); /* hover/focus */
  --kudos-icon:          brightness(0) saturate(100%) invert(69%) sepia(51%) saturate(394%) hue-rotate(321deg) brightness(88%) contrast(89%);
  --lock-icon:           brightness(0) saturate(100%) invert(87%) sepia(12%) saturate(152%) hue-rotate(297deg) brightness(90%) contrast(95%);
  --stats-icon:          brightness(0) saturate(100%) invert(83%) sepia(9%) saturate(1413%) hue-rotate(7deg) brightness(97%) contrast(81%) opacity(75%);
  --rich-txt-content:    invert(99%) sepia(2%) saturate(1652%) hue-rotate(324deg) brightness(88%) contrast(87%);

}

