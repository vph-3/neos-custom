#header::after {
  display: block;
  order: 3;
  width: 100%;
  height: 16.75vw;
  border-top: var(--border-width) solid var(--border2);
  background: url("https://raw.githubusercontent.com/vph-3/neos-custom/refs/heads/my-stuff/yellow_ver_clover_banner.png") 
    var(--bg8) 
    no-repeat;
  background-size: cover;
  content: "";
}

